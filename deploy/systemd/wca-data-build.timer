# WCA publishes its export shortly after 00:00 UTC. 03:30 UTC is overnight in Europe, where
# most of the scramble app's use is; change OnCalendar here if that stops being true.
[Unit]
Description=Nightly WCA data build (wca-records-analyser)

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=15min
# Run at boot if the VM was down at 03:30.
Persistent=true

[Install]
WantedBy=timers.target
