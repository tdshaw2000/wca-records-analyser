# Pulls the newest main image; if it is new, starts it and keeps it only if it turns healthy.
[Unit]
Description=Pull deploy (wca-records-analyser)
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/wca-records-analyser
ExecStart=/usr/bin/python3 /srv/wca-records-analyser/pull_deploy.py
TimeoutStartSec=15min
